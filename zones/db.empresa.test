$TTL 86400

@ IN SOA ns1.empresa.test. admin.empresa.test. (
    2026112101 ; Serial
    3600       ; Refresh
    1800       ; Retry
    604800     ; Expire
    86400      ; Negative Cache TTL
)

; Servidor de nombres
@       IN NS      ns1.empresa.test.

; Registros A
ns1     IN A       192.168.1.10
@       IN A       192.168.1.20
www     IN A       192.168.1.20
correo  IN A       192.168.1.30
api     IN A       192.168.1.40
sistema IN A       192.168.1.50

; Registro CNAME
ftp     IN CNAME   www.empresa.test.

; Registro MX
@       IN MX 10   correo.empresa.test.
